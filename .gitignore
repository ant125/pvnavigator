# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
**/.next/
/out/

# production
/build

# misc
.cursor/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.pydeps/

# WPuQ research raw data (large HDF5; never commit)
research/wpuq/raw/*
!research/wpuq/raw/.gitkeep
research/**/*.hdf5
research/**/*.h5
research/wpuq/.venv/
research/wpuq/**/__pycache__/
research/wpuq/**/.pytest_cache/
research/wpuq/**/.mypy_cache/
research/wpuq/**/.cache/
research/wpuq/**/*.pyc
# Regenerable bulky normalized interval arrays (from raw HDF5)
research/wpuq/processed/profiles_2019_normalized/*
!research/wpuq/processed/profiles_2019_normalized/.gitkeep
research/wpuq/processed/bdew_h25_5000_2019.json
research/wpuq/processed/production_hp_4000_2019.json
research/wpuq/processed/profiles_hp_2019_normalized/*
!research/wpuq/processed/profiles_hp_2019_normalized/.gitkeep
research/wpuq/processed/hp_phase3_arrays.npz
